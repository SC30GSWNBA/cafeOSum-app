generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Core tenant ─────────────────────────────────────────────────────────────

model Cafe {
  id        String   @id @default(cuid())
  name      String
  gstin     String?
  address   String?
  phone     String?
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  tables      Table[]
  menuItems   MenuItem[]
  orders      Order[]
  bills       Bill[]
  ingredients Ingredient[]
  restockLogs RestockLog[]
  auditEvents AuditEvent[]

  @@map("cafes")
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  pwHash         String
  name           String?
  role           UserRole  @default(OWNER)
  isVerified     Boolean   @default(false)
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  cafeId         String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  cafe          Cafe?          @relation(fields: [cafeId], references: [id], onDelete: SetNull)
  refreshTokens RefreshToken[]
  ordersCreated Order[]        @relation("CreatedBy")
  auditEvents   AuditEvent[]

  @@index([cafeId])
  @@map("users")
}

enum UserRole {
  OWNER
  MANAGER
  CASHIER
  WAITER
  KITCHEN
}

// Refresh tokens stored hashed — revoked_at enables rotation + instant logout
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ─── Tables ──────────────────────────────────────────────────────────────────

model Table {
  id        String      @id @default(cuid())
  cafeId    String
  name      String
  seats     Int
  type      String?
  status    TableStatus @default(FREE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  cafe   Cafe    @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([cafeId])
  @@map("tables")
}

enum TableStatus {
  FREE
  OCCUPIED
  BILL_PENDING
}

// ─── Menu ────────────────────────────────────────────────────────────────────

model MenuItem {
  id          String   @id @default(cuid())
  cafeId      String
  name        String
  hindiName   String?
  category    String
  price       Decimal  @db.Decimal(10, 2)
  taxRate     Decimal  @default(5.00) @db.Decimal(5, 2)
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cafe       Cafe        @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  orderLines OrderLine[]
  recipes    Recipe[]

  @@index([cafeId, category])
  @@map("menu_items")
}

// ─── Orders ──────────────────────────────────────────────────────────────────

model Order {
  id          String      @id @default(cuid())
  cafeId      String
  tableId     String
  status      OrderStatus @default(ACTIVE)
  createdById String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  cafe       Cafe        @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  table      Table       @relation(fields: [tableId], references: [id])
  createdBy  User        @relation("CreatedBy", fields: [createdById], references: [id])
  orderLines OrderLine[]
  bill       Bill?

  @@index([cafeId, tableId])
  @@index([cafeId, status])
  @@map("orders")
}

enum OrderStatus {
  ACTIVE
  BILLED
  CANCELLED
}

model OrderLine {
  id               String   @id @default(cuid())
  orderId          String
  menuItemId       String
  qty              Int
  note             String?
  isComp           Boolean  @default(false)
  isKitchenSent    Boolean  @default(false)
  priceSnapshot    Decimal  @db.Decimal(10, 2)
  taxRateSnapshot  Decimal  @default(5.00) @db.Decimal(5, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  @@index([orderId])
  @@map("order_lines")
}

// ─── Billing ─────────────────────────────────────────────────────────────────

model Bill {
  id            String     @id @default(cuid())
  cafeId        String
  orderId       String     @unique
  tableId       String
  status        BillStatus @default(PENDING)
  subtotal      Decimal    @db.Decimal(10, 2)
  discountValue Decimal    @default(0) @db.Decimal(10, 2)
  discountType  String?    // "flat" | "percent"
  taxableAmount Decimal    @db.Decimal(10, 2)
  cgst          Decimal    @db.Decimal(10, 2)
  sgst          Decimal    @db.Decimal(10, 2)
  grandTotal    Decimal    @db.Decimal(10, 2)
  paymentMode   String?    // "cash" | "upi" | "card"
  cashTendered  Decimal?   @db.Decimal(10, 2)
  voidedById    String?
  voidReason    String?
  settledAt     DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  cafe  Cafe  @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id])

  @@index([cafeId, status])
  @@index([cafeId, createdAt])
  @@map("bills")
}

enum BillStatus {
  PENDING
  SETTLED
  VOIDED
}

// ─── Inventory ───────────────────────────────────────────────────────────────

model Ingredient {
  id        String   @id @default(cuid())
  cafeId    String
  name      String
  unit      String   // "g" | "ml" | "pcs" | "kg" | "L"
  stock     Decimal  @default(0) @db.Decimal(10, 3)
  threshold Decimal  @default(0) @db.Decimal(10, 3)
  supplier  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cafe        Cafe         @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  recipes     Recipe[]
  restockLogs RestockLog[]

  @@index([cafeId])
  @@map("ingredients")
}

model Recipe {
  id           String  @id @default(cuid())
  menuItemId   String
  ingredientId String
  qtyPerUnit   Decimal @db.Decimal(10, 3)

  menuItem   MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, ingredientId])
  @@map("recipes")
}

model RestockLog {
  id           String   @id @default(cuid())
  cafeId       String
  ingredientId String
  qtyAdded     Decimal  @db.Decimal(10, 3)
  date         DateTime
  note         String?
  createdAt    DateTime @default(now())

  cafe       Cafe       @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@index([cafeId, createdAt])
  @@map("restock_logs")
}

// ─── Audit (APPEND-ONLY — no UPDATE or DELETE ever permitted) ─────────────────

model AuditEvent {
  id         String   @id @default(cuid())
  eventType  String   // e.g. "LOGIN", "BILL_SETTLED", "ORDER_CREATED"
  cafeId     String?
  userId     String?
  entityType String?  // "bill" | "order" | "table" | "menu_item" | "ingredient"
  entityId   String?
  ipAddress  String?
  payload    Json     @default("{}")
  createdAt  DateTime @default(now())

  cafe Cafe? @relation(fields: [cafeId], references: [id], onDelete: SetNull)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([cafeId, createdAt])
  @@index([cafeId, eventType])
  @@index([entityType, entityId])
  @@map("audit_events")
}
