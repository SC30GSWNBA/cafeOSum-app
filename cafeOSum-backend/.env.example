# Supabase PostgreSQL
# Prisma uses the pooled URL for queries (pgBouncer) and the direct URL for migrations
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# JWT
JWT_ACCESS_SECRET="change-me-32-chars-min-access-secret"
JWT_REFRESH_SECRET="change-me-32-chars-min-refresh-secret"

# Server
PORT=3001
NODE_ENV=development

# CORS — allow the Vite dev server
CORS_ORIGIN="http://localhost:5174"

# Email (stub for Sprint 1 — replace with Resend/SendGrid for production)
EMAIL_FROM="no-reply@cafeosum.com"
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
